# Private data: uploaded plan PDFs, db.json, local backups
data/
.backup/
.env*.local

# Dependencies and build output
node_modules/
.next/
src/generated/
*.tsbuildinfo

# Editor and agent tooling (local only)
.DS_Store
.idea/
.agents/
# .claude/ is versioned (agents, settings.json, own skills); keep machine-local parts out.
# Third-party skills are symlinks into .agents/ and are reinstalled from skills-lock.json.
.claude/settings.local.json
.claude/worktrees/
.claude/skills/*
!.claude/skills/grilling/
!.claude/skills/landing-page-design/

# Playwright e2e
.next-e2e/
test-results/
playwright-report/
tests/e2e/.auth/
tests/e2e/.server.log
tests/e2e/.e2e-run.lock*
tests/e2e/*-snapshots/

# Regenerated by Next.js on every dev/e2e run (points at .next or .next-e2e)
next-env.d.ts
